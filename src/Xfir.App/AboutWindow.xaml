<Window x:Class="Xfir.App.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informazioni su xFirW" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White"
        Icon="Assets/xFirW.ico" FontFamily="Segoe UI" Foreground="#172C46">
  <StackPanel Margin="30">
    <TextBlock Text="xFirW" FontSize="32" FontWeight="SemiBold" />
    <TextBlock x:Name="VersionLabel" Foreground="#68798E" FontSize="13" Margin="0,3,0,0" />
    <TextBlock Text="Visualizzazione e stampa di formulari digitali XFIR" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0" />
    <Border Background="#EDF3FC" CornerRadius="8" Padding="18" Margin="0,22,0,20">
      <StackPanel>
        <TextBlock Text="AUTORE E CONTATTI" Foreground="#68798E" FontSize="10" />
        <TextBlock x:Name="AuthorLabel" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,2" />
        <TextBlock Text="Parma, Italia" Foreground="#68798E" FontSize="13" Margin="0,0,0,6" />
        <TextBox x:Name="EmailLabel" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#2359AD" FontSize="14" Padding="0" />
        <TextBox x:Name="WebsiteLabel" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#2359AD" FontSize="14" Padding="0" Margin="0,2,0,0" />
      </StackPanel>
    </Border>
    <TextBlock Text="Copyright © 2026 Giovanni Bergamaschi e contributori" FontSize="12" TextWrapping="Wrap" />
    <TextBlock Text="Licenza pubblica dell'Unione europea (EUPL) v1.2, legge italiana. Software gratuito e open source, fornito senza garanzie." TextWrapping="Wrap" Foreground="#68798E" FontSize="12" Margin="0,8,0,0" />
    <TextBlock Text="Codice sorgente" FontWeight="SemiBold" FontSize="12" Margin="0,18,0,5" />
    <TextBox Text="https://github.com/greeneye71/xFirW" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#2359AD" Padding="0" FontSize="12" />
    <TextBlock Text="I testi della licenza sono inclusi nei file LICENSE (inglese) e LICENSE-IT.txt (italiano) accanto all'eseguibile." TextWrapping="Wrap" Foreground="#68798E" FontSize="12" Margin="0,8,0,0" />
    <Border Background="#FFF6E5" BorderBrush="#E8C77A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,0">
      <StackPanel>
        <TextBlock Text="ESCLUSIONE DI RESPONSABILITÀ" Foreground="#8A6414" FontSize="10" />
        <TextBlock x:Name="DisclaimerLabel" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" />
      </StackPanel>
    </Border>
    <TextBlock Text="Verifica completa delle firme non eseguita. Progetto indipendente, non affiliato al RENTRI." TextWrapping="Wrap" Foreground="#68798E" FontSize="11" Margin="0,18,0,0" />
    <Button Content="Chiudi" IsCancel="True" IsDefault="True" Click="OnClose" HorizontalAlignment="Right" Margin="0,24,0,0" MinWidth="90" />
  </StackPanel>
</Window>
