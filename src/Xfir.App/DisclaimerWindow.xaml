<Window x:Class="Xfir.App.DisclaimerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="xFirW – Condizioni d'uso" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="White"
        Icon="Assets/xFirW.ico" FontFamily="Segoe UI" Foreground="#172C46">
  <StackPanel Margin="30">
    <TextBlock Text="Esclusione di responsabilità" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Text="Leggere e accettare prima di utilizzare il programma." Foreground="#68798E" FontSize="13" Margin="0,4,0,0" />
    <Border Background="#FFF6E5" BorderBrush="#E8C77A" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,20,0,0">
      <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" FontSize="13" LineHeight="20" />
    </Border>
    <CheckBox x:Name="AcceptCheck" Margin="0,20,0,0" FontSize="13" Checked="OnAcceptChanged" Unchecked="OnAcceptChanged">
      <TextBlock Text="Ho letto e accetto le condizioni sopra indicate" TextWrapping="Wrap" />
    </CheckBox>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="Non accetto" IsCancel="True" Click="OnDecline" MinWidth="110" />
      <Button x:Name="AcceptButton" Content="Accetto" IsDefault="True" IsEnabled="False" Click="OnAccept" MinWidth="110" Margin="0" />
    </StackPanel>
  </StackPanel>
</Window>
