<Window x:Class="Xfir.App.DisclaimerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="xFirW – Condizioni d'uso" Width="560" Height="720" MinWidth="320" MinHeight="280" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="White"
        Icon="Assets/xFirW.ico" FontFamily="Segoe UI" Foreground="#172C46">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Esclusione di responsabilità" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="Leggere e accettare prima di utilizzare il programma." Foreground="#68798E" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
    <Border Background="#FFF6E5" BorderBrush="#E8C77A" BorderThickness="1" CornerRadius="8" Padding="18">
      <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" FontSize="13" LineHeight="20" />
    </Border>
    </ScrollViewer>
    <StackPanel Grid.Row="2">
    <CheckBox x:Name="AcceptCheck" Margin="0,16,0,0" FontSize="13" Checked="OnAcceptChanged" Unchecked="OnAcceptChanged">
      <TextBlock Text="Ho letto e accetto le condizioni sopra indicate" TextWrapping="Wrap" />
    </CheckBox>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="DeclineButton" Content="Non accetto" IsCancel="True" Click="OnDecline" MinWidth="110" />
      <Button x:Name="AcceptButton" Content="Accetto" IsDefault="True" IsEnabled="False" Click="OnAccept" MinWidth="110" Margin="0" />
    </StackPanel>
  </StackPanel>
  </Grid>
</Window>
