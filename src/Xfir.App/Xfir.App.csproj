<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>xFirW</AssemblyName>
    <XfirManifestTemplate>$(MSBuildProjectDirectory)/app.manifest</XfirManifestTemplate>
    <ApplicationIcon>Assets/xFirW.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/ConversionCommand.cs" Link="ConversionCommand.cs" />
    <Compile Include="../Shared/AppArguments.cs" Link="AppArguments.cs" />
    <Compile Include="../Shared/ConsoleCancellation.cs" Link="ConsoleCancellation.cs" />
    <ProjectReference Include="../Xfir.Rendering/Xfir.Rendering.csproj" />
    <Resource Include="Assets/xFirW.ico" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../LICENSE-IT.txt" Link="LICENSE-IT.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../third-party/*" Link="third-party/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../build/GenerateWin32Manifest.targets" />
</Project>
