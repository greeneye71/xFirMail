<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.1</Version>
    <Authors>Giovanni Bergamaschi; xFirW contributors</Authors>
    <Copyright>Copyright (C) 2026 Giovanni Bergamaschi e i contributori di xFirW</Copyright>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/greeneye71/xFirW</RepositoryUrl>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Lock files also cover the self-contained win-x64 Store package. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
