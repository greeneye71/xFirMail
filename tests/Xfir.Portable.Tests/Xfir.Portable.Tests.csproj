<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsPackable>false</IsPackable><IsTestProject>true</IsTestProject></PropertyGroup>
  <ItemGroup>
    <Compile Include="../Xfir.Tests/ReaderTests.cs" Link="ReaderTests.cs" />
    <Compile Include="../Xfir.Tests/BlockARegressionTests.cs" Link="BlockARegressionTests.cs" />
    <Compile Include="../Xfir.Tests/ProcessingLimitsTests.cs" Link="ProcessingLimitsTests.cs" />
    <Compile Include="../Xfir.Tests/AtomicFileWriterTests.cs" Link="AtomicFileWriterTests.cs" />
    <Compile Include="../Xfir.Tests/ConversionCommandTests.cs" Link="ConversionCommandTests.cs" />
    <Compile Include="../../src/Shared/ConversionCommand.cs" Link="ConversionCommand.cs" />
    <ProjectReference Include="../../src/Xfir.Rendering/Xfir.Rendering.csproj" />
    <ProjectReference Include="../../src/Xfir.Mail/Xfir.Mail.csproj" />
    <ProjectReference Include="../../src/Xfir.Cli/Xfir.Cli.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1"><PrivateAssets>all</PrivateAssets></PackageReference>
  </ItemGroup>
  <Target Name="CopyCli" AfterTargets="Build">
    <ItemGroup><CliFiles Include="../../src/Xfir.Cli/bin/$(Configuration)/$(TargetFramework)/**/*"
      Exclude="../../src/Xfir.Cli/bin/$(Configuration)/$(TargetFramework)/linux-x64/**" /></ItemGroup>
    <Copy SourceFiles="@(CliFiles)" DestinationFiles="@(CliFiles->'$(OutDir)cli/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
